{
  "files.exclude": {
    ".appdata": true,
    ".localappdata": true,
    ".temp": true,
    "**/.build": true,
    "**/*.aux": true,
    "**/*.bcf": true,
    "**/*.log": true,
    "**/*.out": true,
    "**/*.run.xml": true,
    "**/*.synctex*": true,
    "**/*.toc": true,
    "**/*.bbl": true,
    "**/*.blg": true,
    "**/*.fdb_latexmk": true,
    "**/*.fls": true,
    "**/*.ptc": true,
    "**/*.xdv": true
  },
  "search.exclude": {
    ".appdata": true,
    ".localappdata": true,
    ".temp": true,
    "**/.build": true,
    "**/*.aux": true,
    "**/*.bcf": true,
    "**/*.log": true,
    "**/*.out": true,
    "**/*.run.xml": true,
    "**/*.synctex*": true,
    "**/*.toc": true,
    "**/*.bbl": true,
    "**/*.blg": true,
    "**/*.fdb_latexmk": true,
    "**/*.fls": true,
    "**/*.ptc": true,
    "**/*.xdv": true
  },
  "latex-workshop.latex.outDir": "%DIR%/.build",
  "latex-workshop.formatting.latex": "latexindent",
  "latex-workshop.formatting.latexindent.path": "/Users/nabian/Documents/Collection-of-Calculus-Exams/.vscode/latexindent-local.sh",
  "latex-workshop.formatting.latexindent.args": [
    "-c",
    "%DIR%",
    "%TMPFILE%",
    "-y=defaultIndent: '%INDENT%'"
  ],
  "[latex]": {
    "editor.defaultFormatter": "James-Yu.latex-workshop"
  }
}
